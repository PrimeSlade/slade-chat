{
  "name": "slade-chat-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Modern full-stack real-time chat application with NestJS, Next.js, Socket.IO, Prisma, Redis, and Better Auth",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @chat/web dev",
    "dev:api": "pnpm --filter @chat/api start:dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @chat/web build",
    "build:api": "pnpm --filter @chat/api build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @chat/api test",
    "test:watch": "pnpm --filter @chat/api test:watch",
    "test:integration": "pnpm --filter @chat/api test:integration",
    "test:e2e": "pnpm --filter @chat/api test:e2e",
    "seed": "pnpm --filter @chat/api seed",
    "db:generate": "pnpm --filter @chat/api exec prisma generate",
    "db:migrate": "pnpm --filter @chat/api exec prisma migrate dev",
    "db:push": "pnpm --filter @chat/api exec prisma db push",
    "db:studio": "pnpm --filter @chat/api exec prisma studio",
    "docker:up": "docker compose -f apps/api/docker-compose.yml up --build",
    "docker:down": "docker compose -f apps/api/docker-compose.yml down"
  },
  "packageManager": "pnpm@10.29.2"
}
