{
  "name": "slade-chat-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Modern full-stack real-time chat application with NestJS, Next.js, Socket.IO, Prisma, Redis, and Better Auth",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:frontend": "pnpm --filter @chat/frontend dev",
    "dev:web": "pnpm --filter @chat/frontend dev",
    "dev:backend": "pnpm --filter @chat/backend start:dev",
    "dev:api": "pnpm --filter @chat/backend start:dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @chat/frontend build",
    "build:web": "pnpm --filter @chat/frontend build",
    "build:backend": "pnpm --filter @chat/backend build",
    "build:api": "pnpm --filter @chat/backend build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @chat/backend test",
    "test:watch": "pnpm --filter @chat/backend test:watch",
    "test:integration": "pnpm --filter @chat/backend test:integration",
    "test:e2e": "pnpm --filter @chat/backend test:e2e",
    "seed": "pnpm --filter @chat/backend seed",
    "db:generate": "pnpm --filter @chat/backend exec prisma generate",
    "db:migrate": "pnpm --filter @chat/backend exec prisma migrate dev",
    "db:push": "pnpm --filter @chat/backend exec prisma db push",
    "db:studio": "pnpm --filter @chat/backend exec prisma studio",
    "docker:up": "docker compose -f backend/docker-compose.yml up --build",
    "docker:down": "docker compose -f backend/docker-compose.yml down"
  },
  "packageManager": "pnpm@10.29.2"
}
